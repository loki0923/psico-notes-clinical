# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# PORT: Puerto del servidor backend
PORT=3000

# DATABASE_URL: Cadena de conexión PostgreSQL (Local, Docker, Supabase, Neon, Render o Railway)
# Formato: postgres://usuario:password@host:puerto/nombre_base_datos
DATABASE_URL="postgres://psiconotes:psiconotes_secret_2026@localhost:5432/psiconotes_clinical"

# Variables para contenedor Docker
POSTGRES_USER="psiconotes"
POSTGRES_PASSWORD="psiconotes_secret_2026"
POSTGRES_DB="psiconotes_clinical"
POSTGRES_PORT=5432

